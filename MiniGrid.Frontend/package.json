    "electron:package": "vite build && electron-builder"
  },
  "dependencies": {
    "@microsoft/signalr": "^8.0.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "concurrently": "^8.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.3.0",
    "vite": "^8.3.1",
    "vue-tsc": "^2.0.0"
  }
}
